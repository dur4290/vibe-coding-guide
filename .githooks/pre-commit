#!/bin/sh
# ============================================================
# 🔐 커밋 보안 검사 — API 키 / 비밀번호 자동 차단
# ============================================================

echo "🔍 보안 검사 중..."

# ── 1. .env 파일 스테이징 차단 ───────────────────────────
ENV_FILES=$(git diff --cached --name-only | grep -E "^\.env" 2>/dev/null || true)

if [ -n "$ENV_FILES" ]; then
  echo ""
  echo "🚨 위험: .env 파일을 커밋하려고 해요!"
  echo ""
  echo "   파일: $ENV_FILES"
  echo ""
  echo "❌ 커밋이 차단됐습니다."
  echo "💡 .env 파일에는 API 키가 들어있어요. 절대 GitHub에 올리면 안 됩니다."
  echo "   .gitignore에 .env가 포함되어 있는지 확인하세요."
  echo ""
  exit 1
fi

# ── 2. API 키 / 비밀번호 패턴 스캔 ──────────────────────
# 추가된 줄(+로 시작)에서만 검사 (삭제된 줄은 무시)
STAGED_DIFF=$(git diff --cached -U0 2>/dev/null | grep "^+" | grep -v "^+++" || true)

# 위험 패턴 목록
check_pattern() {
  PATTERN="$1"
  LABEL="$2"
  MATCH=$(echo "$STAGED_DIFF" | grep -iE "$PATTERN" | grep -v "#" || true)
  if [ -n "$MATCH" ]; then
    echo ""
    echo "🚨 위험: $LABEL 가 발견됐어요!"
    echo ""
    echo "$MATCH" | head -5
    echo ""
    echo "❌ 커밋이 차단됐습니다."
    echo "💡 API 키는 .env 파일에 저장하고 os.environ.get()으로 읽으세요."
    exit 1
  fi
}

check_pattern "sk-ant-api[0-9]" "Anthropic API 키"
check_pattern "sk-proj-[A-Za-z0-9]" "Anthropic 프로젝트 API 키"
check_pattern "ANTHROPIC_API_KEY\s*=\s*['\"]sk" "Anthropic API 키 할당"
check_pattern "openai\.api_key\s*=\s*['\"]sk" "OpenAI API 키"
check_pattern "sk-[A-Za-z0-9]{48}" "OpenAI 형식 API 키"
check_pattern "AIza[A-Za-z0-9_-]{35}" "Google API 키"
check_pattern "password\s*=\s*['\"][^'\"]{6}" "비밀번호 하드코딩"
check_pattern "secret\s*=\s*['\"][^'\"]{8}" "시크릿 하드코딩"

# ── 3. 통과 ──────────────────────────────────────────────
echo "✅ 보안 검사 통과! 커밋을 진행합니다."
exit 0
